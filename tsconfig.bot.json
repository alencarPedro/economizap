{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": false,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"allowSyntheticDefaultImports": true
	},
	"include": ["src/server.ts", "src/types/**/*.d.ts", "src/register.js"],
	"exclude": ["node_modules"]
}
